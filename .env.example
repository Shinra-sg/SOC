# ============================================================================
# AI-SOC Configuration File (Example)
# Copy this file to .env and fill in your actual values
# ============================================================================

# ----------------------------------------------------------------------------
# AI/LLM Configuration
# ----------------------------------------------------------------------------

# Model provider: google, openai, anthropic
MODEL=google/gemini-2.0-flash-lite

# API Keys
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Throttle between API calls (seconds)
THROTTLE_SECONDS=5

# ----------------------------------------------------------------------------
# Database Configuration
# ----------------------------------------------------------------------------

# Database type: sqlite or postgresql
DB_TYPE=sqlite

# SQLite Configuration (for development)
DB_PATH=database/ai_soc.db

# PostgreSQL Configuration (for production)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=ai_soc
# DB_USER=postgres
# DB_PASSWORD=your_postgres_password_here

# ----------------------------------------------------------------------------
# Security & Threat Intelligence
# ----------------------------------------------------------------------------

# VirusTotal API (for IoC enrichment)
# VIRUSTOTAL_API_KEY=your_virustotal_api_key

# AbuseIPDB API (for IP reputation)
# ABUSEIPDB_API_KEY=your_abuseipdb_api_key

# AlienVault OTX API (for threat intelligence)
# ALIENVAULT_API_KEY=your_alienvault_api_key

# ----------------------------------------------------------------------------
# Logging & Monitoring
# ----------------------------------------------------------------------------

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path
LOG_FILE=logs/ai_soc.log

# ----------------------------------------------------------------------------
# Application Settings
# ----------------------------------------------------------------------------

# SOC operation mode: realtime, batch, scan
SOC_MODE=batch

# Auto-response enabled (true/false)
AUTO_RESPONSE_ENABLED=false

# Max severity for auto-response: low, medium, high, critical
AUTO_RESPONSE_MAX_SEVERITY=medium

# SLA deadlines (hours)
SLA_CRITICAL=1
SLA_HIGH=4
SLA_MEDIUM=24
SLA_LOW=72

# ----------------------------------------------------------------------------
# Alerting & Notifications
# ----------------------------------------------------------------------------

# Slack webhook for notifications
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Email notifications
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@example.com
# SMTP_PASSWORD=your_email_password
# ALERT_EMAIL_TO=soc-team@example.com

# ----------------------------------------------------------------------------
# Testing (for development only)
# ----------------------------------------------------------------------------

# Test message for crew testing
CREW_TEST_MESSAGE="Suspicious login activity detected from 192.168.1.100"
CREW_TEST_DATE=2026-08-16

# ----------------------------------------------------------------------------
# Advanced Settings
# ----------------------------------------------------------------------------

# Max concurrent agent executions
MAX_CONCURRENT_AGENTS=5

# Event processing batch size
EVENT_BATCH_SIZE=100

# Threat detection confidence threshold (0-100)
THREAT_CONFIDENCE_THRESHOLD=70

# False positive auto-learning
FALSE_POSITIVE_LEARNING_ENABLED=true
